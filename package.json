{
  "name": "@cliqo/mcp",
  "version": "0.1.0",
  "description": "MCP server for cliqo.link — a pay-per-use (credits) link shortener. Shorten URLs, list/get/revoke links, and check your credit balance from any MCP client.",
  "type": "module",
  "bin": {
    "cliqo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cliqo-link/cliqo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/cliqo-link/cliqo-mcp/issues"
  },
  "homepage": "https://cliqo.link/docs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cliqo",
    "link-shortener",
    "url-shortener",
    "claude"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}